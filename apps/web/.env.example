# API (NestJS) 주소
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Socket.IO 서버 origin
NEXT_PUBLIC_WS_URL=http://localhost:4000
# 이미지 공개 경로 (S3/CDN)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/shop-media/public
# 사이트 절대 URL (canonical, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 키가 없는 소셜 로그인 버튼도 보여줄지 (로컬 확인용, 운영은 false)
NEXT_PUBLIC_SHOW_UNCONFIGURED_AUTH=false
# 앱 딥링크 스킴 — 앱 브리지(결제·본인인증·우편번호) 복귀 주소 검증
NEXT_PUBLIC_APP_SCHEME=hwaso
# 유니버설 링크(iOS)·앱 링크(Android) 검증 파일 — 비우면 /.well-known 파일을 내지 않는다
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
APP_BUNDLE_ID=dev.efface.hwaso
