{
  "name": "@shop/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file=.env --enable-source-maps dist/main.js\"",
    "build": "prisma generate && tsup",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/websockets": "^11.2.6",
    "@prisma/client": "^6.19.3",
    "@shop/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.7"
  }
}
