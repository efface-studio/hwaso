{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.11.1",
      "pnpm": "11.16.0",
      "env": {
        "APP_LINK_HOST": "hwaso.kr"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.staging.hwaso.kr/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://api.staging.hwaso.kr",
        "EXPO_PUBLIC_MEDIA_URL": "https://media.staging.hwaso.kr/public",
        "EXPO_PUBLIC_WEB_URL": "https://staging.hwaso.kr"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.hwaso.kr/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://api.hwaso.kr",
        "EXPO_PUBLIC_MEDIA_URL": "https://media.hwaso.kr/public",
        "EXPO_PUBLIC_WEB_URL": "https://hwaso.kr"
      }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "", "appleTeamId": "" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
